<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>New entry — Ledger</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper: #F6F2E9;
    --paper-raised: #FFFDF8;
    --ink: #2B2A28;
    --ink-soft: #6B675E;
    --rule: #DEDACD;
    --rule-strong: #C9C4B3;
    --accent-deep: #5F4A24;
    --danger: #A34732;
    --radius: 3px;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  .wrap{
    max-width: 640px;
    margin: 0 auto;
    padding: 0 20px 96px;
  }

  header.site{
    padding: 48px 0 24px;
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  header.site h1{
    font-family: 'Source Serif 4', serif;
    font-weight: 600;
    font-size: 34px;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .back-link{
    font-size: 13px;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .back-link:hover{ color: var(--ink); border-bottom-color: var(--ink-soft); }

  .panel{
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 26px 26px 22px;
    margin-top: 28px;
  }

  .panel h2{
    font-family: 'Source Serif 4', serif;
    font-size: 21px;
    font-weight: 600;
    margin: 0 0 20px;
  }

  .field{ margin-bottom: 18px; }
  .field label{
    display: block;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .field input[type=text], .field textarea{
    width: 100%;
    font-family: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 11px 13px;
    resize: vertical;
  }
  .field input[type=text]:focus, .field textarea:focus{
    outline: none;
    border-color: var(--ink);
  }
  .field textarea{ min-height: 220px; line-height: 1.6; }

  .hint{
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 6px;
  }

  .error-text{
    font-size: 12.5px;
    color: var(--danger);
    margin-top: 6px;
    display: none;
  }

  .panel-actions{
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 8px;
    border-top: 1px solid var(--rule);
    padding-top: 18px;
  }

  button{ font-family: inherit; cursor: pointer; }

  .btn{
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    color: var(--ink);
    padding: 10px 18px;
    border-radius: var(--radius);
    font-size: 14px;
    font-weight: 500;
    transition: border-color .15s ease, background .15s ease;
  }
  .btn:hover{ border-color: var(--ink-soft); }
  .btn:focus-visible{ outline: 2px solid var(--ink); outline-offset: 2px; }

  .btn-primary{
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-raised);
  }
  .btn-primary:hover{ background: var(--accent-deep); border-color: var(--accent-deep); }

  .success-banner{
    display: none;
    margin-top: 28px;
    padding: 14px 16px;
    background: #EEF2E4;
    border: 1px solid #C9D3AE;
    border-radius: var(--radius);
    font-size: 14px;
    color: #45532B;
  }

  @media (max-width: 480px){
    header.site{ padding-top: 32px; }
    header.site h1{ font-size: 27px; }
    .panel{ padding: 20px 16px 18px; }
    .panel-actions{ flex-direction: column-reverse; }
    .panel-actions .btn{ width: 100%; text-align: center; }
  }
</style>
</head>
<body>

<div class="wrap">
  <header class="site">
    <h1>Ledger</h1>
    <a class="back-link" href="/">&larr; Back to all posts</a>
  </header>

  <div class="panel">
    <h2>New entry</h2>
    <form action="/new" method="POST">
      <div class="field">
        <label for="field-title">Title</label>
        <input type="text" id="field-title" name ="title" placeholder="Give it a name" autocomplete="off">
      </div>
      <div class="field">
        <label for="field-content">Entry</label>
        <textarea id="field-content" name ="content" placeholder="Write what happened"></textarea>
        <div class="hint">Plain text — no formatting needed.</div>
        <br>
        <label for="date">Date</label>
        <input type="text" id="field-content" name ="date" placeholder="eg. August 16, 2026" autocomplete="off">
        <br>
        <br>
        <label for="field-title">Title</label>
        <input type="text" id="field-content" name ="time" placeholder="eg. 6:01 pm" autocomplete="off">
      </div>
      <div id="form-error" class="error-text"></div>
      <div class="panel-actions">
        <a href="/" class="btn" id="cancel-btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Publish entry</button>
      </div>
    </form>
  </div>


  <% if (locals.added) { %>
    <div class="success-banner" style="display: block;">
        Entry published.
    </div>
<% } %>
</div>

</body>
</html>