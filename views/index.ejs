<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ledger — a simple blog</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper: #F6F2E9;
    --paper-raised: #FFFDF8;
    --ink: #2B2A28;
    --ink-soft: #6B675E;
    --rule: #DEDACD;
    --rule-strong: #C9C4B3;
    --accent: #8A6D3B;
    --accent-deep: #5F4A24;
    --danger: #A34732;
    --danger-bg: #F5E4DE;
    --focus: #2B2A28;
    --radius: 3px;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  .wrap{
    max-width: 700px;
    margin: 0 auto;
    padding: 0 20px 96px;
  }

  header.site{
    padding: 48px 0 28px;
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  header.site h1{
    font-family: 'Source Serif 4', serif;
    font-weight: 600;
    font-size: 34px;
    margin: 0;
    letter-spacing: -0.01em;
  }

  header.site .tag{
    font-size: 13px;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .toolbar{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 28px 0 20px;
  }

  .count{
    font-size: 13px;
    color: var(--ink-soft);
  }

  button{
    font-family: inherit;
    cursor: pointer;
  }

  .btn{
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    color: var(--ink);
    padding: 9px 16px;
    border-radius: var(--radius);
    font-size: 14px;
    font-weight: 500;
    transition: border-color .15s ease, background .15s ease;
  }
  .btn:hover{ border-color: var(--ink-soft); }
  .btn:focus-visible{ outline: 2px solid var(--focus); outline-offset: 2px; }

  .btn-primary{
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-raised);
  }
  .btn-primary:hover{ background: var(--accent-deep); border-color: var(--accent-deep); }

  .btn-text{
    background: none;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
    color: var(--ink-soft);
    border-radius: var(--radius);
  }
  .btn-text:hover{ color: var(--ink); background: var(--rule); }
  .btn-text.danger:hover{ color: var(--danger); background: var(--danger-bg); }

  .post-card{
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 20px 22px;
    margin-bottom: 14px;
  }

  .post-card h2{
    font-family: 'Source Serif 4', serif;
    font-weight: 600;
    font-size: 21px;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .post-meta{
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-bottom: 10px;
  }

  .post-excerpt{
    font-size: 15px;
    line-height: 1.6;
    color: #3F3D38;
    margin: 0 0 14px;
    white-space: pre-wrap;
  }

  .post-actions{
    display: flex;
    gap: 4px;
    border-top: 1px solid var(--rule);
    padding-top: 10px;
    margin-top: 2px;
  }

  /* Empty state */
  .empty{
    text-align: center;
    padding: 64px 20px;
    color: var(--ink-soft);
  }
  .empty h3{
    font-family: 'Source Serif 4', serif;
    font-size: 20px;
    color: var(--ink);
    margin: 0 0 8px;
    font-weight: 600;
  }
  .empty p{ margin: 0 0 20px; font-size: 14px; }

  .panel{
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 22px 22px 18px;
    margin-bottom: 22px;
  }

  .panel h3{
    font-family: 'Source Serif 4', serif;
    font-size: 19px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .field{ margin-bottom: 14px; }
  .field label{
    display: block;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .field input[type=text], .field textarea{
    width: 100%;
    font-family: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 10px 12px;
    resize: vertical;
  }
  .field input[type=text]:focus, .field textarea:focus{
    outline: none;
    border-color: var(--ink);
  }
  .field textarea{ min-height: 140px; line-height: 1.55; }

  .error-text{
    font-size: 12.5px;
    color: var(--danger);
    margin-top: 6px;
  }

  .panel-actions{
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 6px;
  }

  .confirm-row{
    display:flex;
    align-items:center;
    gap:10px;
    font-size: 13px;
    color: var(--danger);
  }

  a {
    text-decoration: none;
    color: inherit;
}

  footer.site{
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-soft);
    padding-top: 40px;
  }

  @media (max-width: 480px){
    header.site{ padding-top: 32px; }
    header.site h1{ font-size: 27px; }
    .post-card{ padding: 16px 16px; }
    .panel{ padding: 18px 16px 14px; }
    .toolbar{ flex-direction: column; align-items: stretch; }
    .btn-primary.new-post{ width: 100%; text-align: center; }
  }

  .sr-only{
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }
</style>
</head>
<body>

<div class="wrap">
  <header class="site">
    <h1>Ledger</h1>
    <span class="tag" id="post-count-tag"></span>
  </header>

  <div class="toolbar">
    <span class="count" id="entry-count"></span>
  <a href="/new" class="btn btn-primary new-post" id="new-post-btn">
    + New post
</a>
  </div>

  <div id="form-mount"></div>
  <div id="list-mount"></div>

   <div id="list-mount">

    <% blogs.forEach((blog) => { %>
      <article class="post-card">
        <h2><%=blog.title%></h2>
        <div class="post-meta"><%= blog.date %> · <%= blog.time %></div>
        <p class="post-excerpt"><%= blog.content %></p>
        <form action="/delete/<%= blog.id %>" method="POST">
    <button type="submit" class="btn btn-primary">Delete</button>
    <a href="/edit/<%= blog.id %>" class="btn">
    Edit
</a>
    </form>
      </article>
    <% }) %>

    

    <!-- <article class="post-card">
      <h2>Welcome to Ledger</h2>
      <div class="post-meta">Aug 16, 2026 · 10:24 AM</div>
      <p class="post-excerpt">This is a sample entry to show how a post looks on the home page. Swap this block for your real data.</p>
    </article>

    <article class="post-card">
      <h2>Second entry</h2>
      <div class="post-meta">Aug 15, 2026 · 6:02 PM</div>
      <p class="post-excerpt">Each card shows a title, a timestamp, and a trimmed preview of the entry. Longer entries are cut off with an ellipsis.</p>
    </article>

    <article class="post-card">
      <h2>Third entry</h2>
      <div class="post-meta">Aug 14, 2026 · 9:15 AM</div>
      <p class="post-excerpt">Repeat this article block once per post when you wire it up to your real data.</p>
    </article> -->

  </div>
</div>

</body>
</html>